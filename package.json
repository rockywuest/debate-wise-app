{
  "name": "debate-wise-app",
  "private": true,
  "version": "0.1.0",
  "description": "AI-assisted debate platform for structured, evidence-based discussion.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bash scripts/check.sh",
    "check:i18n": "bash scripts/check-i18n.sh",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "smoke:routes": "bash scripts/smoke-routes.sh",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "preview": "vite preview"
  },
