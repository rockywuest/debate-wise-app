    "autoprefixer": "^10.5.4",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
